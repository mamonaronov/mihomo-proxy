# Installed by ./deploy.sh (WorkingDirectory is rewritten to the repo path).
# ExecStart/ExecStop docker path is rewritten too.
# Manual:
#   sudo cp deploy/mihomo-proxy.service /etc/systemd/system/mihomo-proxy.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mihomo-proxy.service

[Unit]
Description=Mihomo SOCKS5 proxy for Telegram bots
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/mihomo-proxy
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=0
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
